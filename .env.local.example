# ============================================================
# GradPrep – Firebase Configuration
# ============================================================
# CARA SETUP:
# 1. Buka https://console.firebase.google.com
# 2. Klik "Add project" → beri nama (misal: gradprep)
# 3. Setelah project dibuat, klik ikon Web (</>) di halaman Project Overview
# 4. Register app → Firebase akan menampilkan firebaseConfig
# 5. Salin nilai-nilai di bawah sesuai config tersebut
# 6. Copy file ini ke .env.local (bukan .env.local.example)
# 7. PENTING: Aktifkan Firestore Database di Firebase Console:
#    Build → Firestore Database → Create database → Start in test mode
# 8. Deploy ulang ke Vercel & tambahkan semua env vars ini di:
#    Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=nama-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nama-project
VITE_FIREBASE_STORAGE_BUCKET=nama-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdefghij
